{
  "name": "daimeow-dsh",
  "version": "1.0.0",
  "private": true,
  "description": "呆喵：运行在 DeepSeek Harness 中的《怪物猎人》艾露猫 Live2D 桌面宠物插件",
  "author": "yubdey",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yubdey/daimeow-dsh.git"
  },
  "homepage": "https://github.com/yubdey/daimeow-dsh#readme",
  "bugs": {
    "url": "https://github.com/yubdey/daimeow-dsh/issues"
  },
  "type": "module",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "desktop-pet",
    "live2d"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.png",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "screen-reply.js",
    "client.js",
    "cordis.patch.yml",
    "runtime/electron-helper",
    "locale/*.json",
    "icon.png",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-layout"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-llm": "^0.2.0-rc.1"
  },
  "scripts": {
    "build": "node scripts/build-client.mjs && node scripts/build-helper.mjs",
    "check": "node --check index.js && node --check screen-reply.js && node --check client.js && node --check runtime/electron-helper/main.js && node --check runtime/electron-helper/preload.js && node --check runtime/electron-helper/pet-renderer.js",
    "test": "node --test --test-isolation=none"
  },
  "license": "MIT"
}
